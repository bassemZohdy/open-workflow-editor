# Browser-safe gateway location. This is not a runtime credential.
VITE_RUNTIME_GATEWAY_URL=http://127.0.0.1:8787

# Server-only values. Never rename these with a VITE_ prefix.
OPEN_WORKFLOW_RUNTIME_BASE_URL=http://127.0.0.1:8080
OPEN_WORKFLOW_RUNTIME_AUTH_TOKEN=
OPEN_WORKFLOW_RUNTIME_NAME=Open Workflow Java runtime
